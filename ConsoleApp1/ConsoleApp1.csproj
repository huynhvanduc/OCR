<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IronOCR: wrapper thông minh, tự pre-process, không cần tessdata thủ công -->
    <PackageReference Include="IronOcr" Version="2026.5.2" />
    <!-- OpenCV: khử nhiễu và nhị phân hóa ảnh trước khi OCR -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.linux-x64" Version="4.10.0.20240717" />
  </ItemGroup>

</Project>
