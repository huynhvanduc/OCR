<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IronOCR: wrapper thông minh, tự pre-process, không cần tessdata thủ công -->
    <PackageReference Include="IronOcr" Version="2026.5.2" />
    <!-- SkiaSharp: pre-process ảnh trước khi OCR -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>

</Project>
